<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabOLEPackager" getLabel="RibbonGetLabel">
        <group id="grpInsert" getLabel="RibbonGetLabel">
          <button id="btnInsertPlotFolder"
                  getLabel="RibbonGetLabel"
                  size="large"
                  image="InsertOLEPackageIcon"
                  getScreentip="RibbonGetScreentip"
                  getSupertip="RibbonGetSupertip"
                  onAction="RibbonInsertPlotFolder"/>
          <button id="btnInsertImageSupportFiles"
                  getLabel="RibbonGetLabel"
                  size="large"
                  image="InsertImageFilesIcon"
                  getScreentip="RibbonGetScreentip"
                  getSupertip="RibbonGetSupertip"
                  onAction="RibbonInsertImageSupportFiles"/>
          <button id="btnAttachSupportFilesToSelectedImage"
                  getLabel="RibbonGetLabel"
                  size="large"
                  image="ManageImageOleFilesIcon"
                  getScreentip="RibbonGetScreentip"
                  getSupertip="RibbonGetSupertip"
                  onAction="RibbonAttachSupportFilesToSelectedImage"/>
          <button id="btnShowUsage"
                  getLabel="RibbonGetLabel"
                  size="large"
                  image="UsageHelpIcon"
                  getScreentip="RibbonGetScreentip"
                  getSupertip="RibbonGetSupertip"
                  onAction="RibbonShowUsage"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
