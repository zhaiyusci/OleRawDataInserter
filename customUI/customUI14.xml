<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabOleRawDataInserter" label="Figure Package">
        <group id="grpInsert" label="Insert">
          <button id="btnInsertPlotFolder"
                  label="Insert Figure Package"
                  size="large"
                  image="FigurePackageIcon"
                  screentip="Insert plot.png with source files"
                  supertip="Choose a folder containing plot.png. The add-in embeds the whole folder as a zip OLE object and displays plot.png."
                  onAction="RibbonInsertPlotFolder"/>
          <button id="btnShowUsage"
                  label="Usage"
                  imageMso="Help"
                  screentip="Show usage instructions"
                  supertip="Learn how to prepare plot.py, plot.png, and raw data before inserting a figure package."
                  onAction="RibbonShowUsage"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
